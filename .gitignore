# forge-std is a git checkout, not an npm package — the only Solidity
# dependency that isn't in package.json. Reinstall with:
#   forge install foundry-rs/forge-std@bf647bd6046f2f7da30d0c2bf435e5c76a780c1b --no-git
#
# Leading slash matters: a bare `lib/` also matches `src/lib/`, which is
# most of the frontend.
